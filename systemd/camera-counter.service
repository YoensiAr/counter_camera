[Unit]
Description=Camera Counter - Entradas y salidas
After=network-online.target
Wants=network-online.target
StartLimitIntervalSec=0

[Service]
Type=simple
User=@USER@
SupplementaryGroups=video render
WorkingDirectory="@ROOT@"
ExecStart="@ROOT@/.venv/bin/python" "@ROOT@/main.py" --config "@ROOT@/config.yaml" --headless
Environment=PYTHONUNBUFFERED=1
Environment=YOLO_OFFLINE=true
Environment=YOLO_AUTOINSTALL=false
EnvironmentFile="-@ROOT@/service.env"
Restart=always
RestartSec=5
TimeoutStopSec=20
KillSignal=SIGTERM
StandardOutput=journal
StandardError=journal
UMask=0077

[Install]
WantedBy=multi-user.target
